generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PHARMACIST
  CASHIER
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  OTHER
}

enum NotificationType {
  IN_STOCK
  LOW_STOCK
  EXPIRING_SOON
  OUT_OF_STOCK
}

model User {
  id           String   @id @default(uuid())
  name         String?
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(CASHIER)
  createdAt    DateTime @default(now()) @map("created_at")

  sales       Sale[]
  saleReturns SaleReturn[]

  @@map("users")
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")

  sales Sale[]

  @@map("customers")
}

model Category {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("categories")
}

model Supplier {
  id            String   @id @default(uuid())
  name          String
  contactPerson String   @map("contact_person")
  phone         String
  email         String?
  address       String?
  paymentTerms  String   @map("payment_terms")
  createdAt     DateTime @default(now()) @map("created_at")

  products  Product[]
  purchases Purchase[]

  @@map("suppliers")
}

// The permanent, barcode-identified catalog entry. One row per distinct
// medicine + strength + pack size — never changes when new stock arrives.
model Product {
  id                String   @id @default(uuid())
  name              String
  brand             String
  barcode           String?  @unique
  categoryId        String   @map("category_id")
  defaultSupplierId String?  @map("default_supplier_id")
  sellingPrice      Decimal  @map("selling_price") @db.Decimal(10, 2)
  reorderLevel      Int      @default(20) @map("reorder_level")
  isActive          Boolean  @default(true) @map("is_active")
  description       String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  category        Category       @relation(fields: [categoryId], references: [id])
  defaultSupplier Supplier?      @relation(fields: [defaultSupplierId], references: [id])
  stockBatches    StockBatch[]
  purchaseItems   PurchaseItem[]
  notifications   Notification[]

  @@index([categoryId])
  @@index([defaultSupplierId])
  @@map("products")
}

model Purchase {
  id               String         @id @default(uuid())
  poNumber         String         @unique @map("po_number")
  sequenceNumber   Int            @default(autoincrement()) @map("sequence_number")
  supplierId       String         @map("supplier_id")
  orderDate        DateTime       @map("order_date") @db.Date
  expectedDelivery DateTime?      @map("expected_delivery") @db.Date
  status           PurchaseStatus @default(PENDING)
  totalAmount      Decimal        @map("total_amount") @db.Decimal(10, 2)
  createdAt        DateTime       @default(now()) @map("created_at")

  supplier Supplier       @relation(fields: [supplierId], references: [id])
  items    PurchaseItem[]

  @@index([supplierId])
  @@map("purchases")
}

model PurchaseItem {
  id              String   @id @default(uuid())
  purchaseId      String   @map("purchase_id")
  productId       String   @map("product_id")
  batchNumber     String   @map("batch_number")
  expiryDate      DateTime @map("expiry_date") @db.Date
  quantity        Int
  purchasedAmount Decimal  @map("purchased_amount") @db.Decimal(10, 2)
  purchasePrice   Decimal  @map("purchase_price") @db.Decimal(10, 2)
  sellingAmount   Decimal  @map("selling_amount") @db.Decimal(10, 2)
  sellingPrice    Decimal  @map("selling_price") @db.Decimal(10, 2)

  purchase   Purchase    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id])
  stockBatch StockBatch?

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model StockBatch {
  id             String   @id @default(uuid())
  productId      String   @map("product_id")
  purchaseItemId String?  @unique @map("purchase_item_id")
  batchNumber    String   @map("batch_number")
  expiryDate     DateTime @map("expiry_date") @db.Date
  quantityOnHand Int      @map("quantity_on_hand")
  purchasePrice  Decimal  @map("purchase_price") @db.Decimal(10, 2)
  receivedAt     DateTime @default(now()) @map("received_at")

  product       Product        @relation(fields: [productId], references: [id])
  purchaseItem  PurchaseItem?  @relation(fields: [purchaseItemId], references: [id])
  saleItems     SaleItem[]
  notifications Notification[]

  @@index([productId])
  @@index([expiryDate])
  @@map("stock_batches")
}

model Sale {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique @map("invoice_number")
  sequenceNumber  Int           @default(autoincrement()) @map("sequence_number")
  userId          String        @map("user_id")
  customerId      String?       @map("customer_id")
  soldAt          DateTime      @default(now()) @map("sold_at")
  subtotalAmount  Decimal       @map("subtotal_amount") @db.Decimal(10, 2)
  discountPercent Decimal       @default(0) @map("discount_percent") @db.Decimal(5, 2)
  totalAmount     Decimal       @map("total_amount") @db.Decimal(10, 2)
  paymentMethod   PaymentMethod @default(CASH) @map("payment_method")
  cashTendered    Decimal?      @map("cash_tendered") @db.Decimal(10, 2)

  user     User         @relation(fields: [userId], references: [id])
  customer Customer?    @relation(fields: [customerId], references: [id])
  items    SaleItem[]
  returns  SaleReturn[]

  @@index([userId])
  @@index([customerId])
  @@map("sales")
}

model SaleItem {
  id              String  @id @default(uuid())
  saleId          String  @map("sale_id")
  batchId         String  @map("batch_id")
  quantity        Int
  price           Decimal @db.Decimal(10, 2)
  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)

  sale        Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  batch       StockBatch       @relation(fields: [batchId], references: [id])
  returnItems SaleReturnItem[]

  @@index([saleId])
  @@index([batchId])
  @@map("sale_items")
}

// An immutable record of a return/refund against a Sale. The original Sale and its
// SaleItems are never edited — a return is always a new record layered on top, the
// same way a credit note reverses an invoice in standard accounting practice.
model SaleReturn {
  id             String   @id @default(uuid())
  returnNumber   String   @unique @map("return_number")
  sequenceNumber Int      @default(autoincrement()) @map("sequence_number")
  saleId         String   @map("sale_id")
  userId         String   @map("user_id")
  reason         String?
  refundAmount   Decimal  @map("refund_amount") @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  sale  Sale             @relation(fields: [saleId], references: [id])
  user  User             @relation(fields: [userId], references: [id])
  items SaleReturnItem[]

  @@index([saleId])
  @@map("sale_returns")
}

model SaleReturnItem {
  id           String  @id @default(uuid())
  saleReturnId String  @map("sale_return_id")
  saleItemId   String  @map("sale_item_id")
  quantity     Int
  // Whether this return put the quantity back into sellable stock. Pharmacies often
  // can't resell dispensed medicine, so this is chosen per return, not assumed.
  restocked    Boolean @default(false)

  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id])

  @@index([saleReturnId])
  @@index([saleItemId])
  @@map("sale_return_items")
}

model Notification {
  id        String           @id @default(uuid())
  productId String?          @map("product_id")
  batchId   String?          @map("batch_id")
  type      NotificationType
  message   String
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  product Product?    @relation(fields: [productId], references: [id])
  batch   StockBatch? @relation(fields: [batchId], references: [id])

  @@map("notifications")
}
