generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PHARMACIST
  CASHIER
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  OTHER
}

enum NotificationType {
  IN_STOCK
  LOW_STOCK
  EXPIRING_SOON
  OUT_OF_STOCK
}

model User {
  id           String   @id @default(uuid())
  name         String?
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(CASHIER)
  createdAt    DateTime @default(now()) @map("created_at")

  sales        Sale[]

  @@map("users")
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")

  sales     Sale[]

  @@map("customers")
}

model Category {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  products    Product[]

  @@map("categories")
}

model Supplier {
  id             String   @id @default(uuid())
  name           String
  contactPerson  String   @map("contact_person")
  phone          String
  email          String?
  address        String?
  paymentTerms   String   @map("payment_terms")
  createdAt      DateTime @default(now()) @map("created_at")

  products       Product[]
  purchases      Purchase[]

  @@map("suppliers")
}

// The permanent, barcode-identified catalog entry. One row per distinct
// medicine + strength + pack size — never changes when new stock arrives.
model Product {
  id                 String   @id @default(uuid())
  name               String
  brand              String
  barcode            String?  @unique
  categoryId         String   @map("category_id")
  defaultSupplierId  String?  @map("default_supplier_id")
  sellingPrice       Decimal  @map("selling_price") @db.Decimal(10, 2)
  reorderLevel       Int      @default(20) @map("reorder_level")
  description        String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  category           Category        @relation(fields: [categoryId], references: [id])
  defaultSupplier    Supplier?       @relation(fields: [defaultSupplierId], references: [id])
  stockBatches       StockBatch[]
  purchaseItems      PurchaseItem[]
  notifications      Notification[]

  @@index([categoryId])
  @@index([defaultSupplierId])
  @@map("products")
}

// One row per shipment received. Same product can have several open
// batches at once, each with its own expiry date and remaining quantity.
model StockBatch {
  id              String    @id @default(uuid())
  productId       String    @map("product_id")
  purchaseItemId  String?   @unique @map("purchase_item_id")
  batchNumber     String    @map("batch_number")
  expiryDate      DateTime  @map("expiry_date") @db.Date
  quantityOnHand  Int       @map("quantity_on_hand")
  costPrice       Decimal   @map("cost_price") @db.Decimal(10, 2)
  receivedAt      DateTime  @default(now()) @map("received_at")

  product         Product       @relation(fields: [productId], references: [id])
  purchaseItem    PurchaseItem? @relation(fields: [purchaseItemId], references: [id])
  saleItems       SaleItem[]
  notifications   Notification[]

  @@index([productId])
  @@index([expiryDate])
  @@map("stock_batches")
}

model Purchase {
  id               String         @id @default(uuid())
  poNumber         String         @unique @map("po_number")
  sequenceNumber   Int            @default(autoincrement()) @map("sequence_number")
  supplierId       String         @map("supplier_id")
  orderDate        DateTime       @map("order_date") @db.Date
  expectedDelivery DateTime?      @map("expected_delivery") @db.Date
  status           PurchaseStatus @default(PENDING)
  totalAmount      Decimal        @map("total_amount") @db.Decimal(10, 2)
  createdAt        DateTime       @default(now()) @map("created_at")

  supplier         Supplier       @relation(fields: [supplierId], references: [id])
  items            PurchaseItem[]

  @@index([supplierId])
  @@map("purchases")
}

model PurchaseItem {
  id           String    @id @default(uuid())
  purchaseId   String    @map("purchase_id")
  productId    String    @map("product_id")
  batchNumber  String    @map("batch_number")
  expiryDate   DateTime  @map("expiry_date") @db.Date
  quantity     Int
  costPrice    Decimal   @map("cost_price") @db.Decimal(10, 2)

  purchase     Purchase    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product      Product     @relation(fields: [productId], references: [id])
  stockBatch   StockBatch?

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model Sale {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique @map("invoice_number")
  sequenceNumber  Int           @default(autoincrement()) @map("sequence_number")
  userId          String        @map("user_id")
  customerId      String?       @map("customer_id")
  soldAt          DateTime      @default(now()) @map("sold_at")
  totalAmount     Decimal       @map("total_amount") @db.Decimal(10, 2)
  paymentMethod   PaymentMethod @default(CASH) @map("payment_method")

  user            User          @relation(fields: [userId], references: [id])
  customer        Customer?     @relation(fields: [customerId], references: [id])
  items           SaleItem[]

  @@index([userId])
  @@index([customerId])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String  @map("sale_id")
  batchId   String  @map("batch_id")
  quantity  Int
  price     Decimal @db.Decimal(10, 2)

  sale      Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  batch     StockBatch @relation(fields: [batchId], references: [id])

  @@index([saleId])
  @@index([batchId])
  @@map("sale_items")
}

model Notification {
  id         String            @id @default(uuid())
  productId  String?           @map("product_id")
  batchId    String?           @map("batch_id")
  type       NotificationType
  message    String
  isRead     Boolean           @default(false) @map("is_read")
  createdAt  DateTime          @default(now()) @map("created_at")

  product    Product?          @relation(fields: [productId], references: [id])
  batch      StockBatch?       @relation(fields: [batchId], references: [id])

  @@map("notifications")
}